# Grocery Agent Configuration
# Copy this file to .env and customize for your environment.
# Every setting is optional; the defaults are in config.py. Don't commit your .env file.

# ============ Environment ============
# Options: development, production, testing
ENV=development

# ============ LLM Model Settings ============
# Path to the MLX model directory used by the agent
MODEL_PATH=./models/llama-3-8b-instruct-mlx

# Temperature for generation (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.7

# Maximum tokens to generate per response
LLM_MAX_TOKENS=1024

# How many times an invalid meal plan is sent back to the model for correction
MAX_REPAIR_ATTEMPTS=2

# ============ Eval Judge ============
# MLX model directory used as the LLM judge in eval.py
JUDGE_MODEL_PATH=./models/gemma-4-e4b-it-4bit

# The judge writes its reasoning before the verdict, so it needs a large token budget
JUDGE_MAX_TOKENS=2048

# ============ Data Storage ============
# Path to pantry data file
PANTRY_FILE=data/pantry.json

# Path to conversation memory file
MEMORY_FILE=memory/conversation.json

# ============ Logging ============
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
